# ZeptoBrain Environment Variables
# Copy this to .env and fill in values

# App
ENV=development
PORT=8000

# Database (optional — uses CSV/SQLite by default in dev)
DATABASE_URL=postgresql://user:password@localhost:5432/zeptobrain

# Redis (optional — for caching in prod)
REDIS_URL=redis://localhost:6379

# Model paths
MODEL_PATH=./ml/demand_model.pkl
ENCODER_PATH=./ml/encoders.pkl
DATA_PATH=./data/inventory_history.csv
